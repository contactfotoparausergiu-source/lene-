        // Appointments Management
        function openAppointmentModal() {
            document.getElementById('appointmentModalTitle').innerText = "Adaugă Programare Manual";
            document.getElementById('editAppointmentId').value = "";
            document.getElementById('modalAppName').value = "";
            document.getElementById('modalAppPhone').value = "";
            document.getElementById('modalAppType').value = "";
            document.getElementById('modalAppPackage').value = "";
            document.getElementById('modalAppDate').value = "";
            document.getElementById('modalAppTime').value = "";
            document.getElementById('modalAppStatus').value = "În așteptare";
            document.getElementById('appointmentModal').classList.add('active');
        }

        function editAppointment(id) {
            const data = getStoredData();
            const app = data.appointments.find(x => x.id === id);
            if(!app) return;
            document.getElementById('appointmentModalTitle').innerText = "Editează Programare";
            document.getElementById('editAppointmentId').value = app.id;
            document.getElementById('modalAppName').value = app.name;
            document.getElementById('modalAppPhone').value = app.phone;
            document.getElementById('modalAppType').value = app.sessionType;
            document.getElementById('modalAppPackage').value = app.packageVal;
            document.getElementById('modalAppDate').value = app.date;
            document.getElementById('modalAppTime').value = app.time;
            document.getElementById('modalAppStatus').value = app.status;
            document.getElementById('appointmentModal').classList.add('active');
        }

        function saveAppointmentData(e) {
            e.preventDefault();
            const idVal = document.getElementById('editAppointmentId').value;
            const name = document.getElementById('modalAppName').value.trim();
            const phone = document.getElementById('modalAppPhone').value.trim();
            const sessionType = document.getElementById('modalAppType').value.trim();
            const packageVal = document.getElementById('modalAppPackage').value.trim();
            const date = document.getElementById('modalAppDate').value;
            const time = document.getElementById('modalAppTime').value;
            const status = document.getElementById('modalAppStatus').value;
            const data = getStoredData();

            if(idVal) {
                const app = data.appointments.find(x => x.id == idVal);
                if(app) {
                    app.name = name;
                    app.phone = phone;
                    app.sessionType = sessionType;
                    app.packageVal = packageVal;
                    app.date = date;
                    app.time = time;
                    app.status = status;
                }
            } else {
                data.appointments.push({
                    id: Date.now(),
                    name,
                    phone,
                    sessionType,
                    packageVal,
                    extraVal: "Niciunul",
                    date,
                    time,
                    persons: "2",
                    outfits: "1",
                    details: "Adăugat manual de administrator",
                    status
                });
            }
            saveStoredData(data);
            closeModal('appointmentModal');
            renderAdminPanel();
        }

        function toggleAppStatus(id) {
            const data = getStoredData();
            const app = data.appointments.find(x => x.id === id);
            if(app) {
                if(app.status === 'În așteptare') app.status = 'Prezent';
                else if(app.status === 'Prezent') app.status = 'Anulat';
                else app.status = 'În așteptare';
                saveStoredData(data);
                renderAdminPanel();
            }
        }

        function deleteAppointment(id) {
            if(confirm("Sigur doriți să ștergeți această programare?")) {
                const data = getStoredData();
                data.appointments = data.appointments.filter(x => x.id !== id);
                saveStoredData(data);
                renderAdminPanel();
            }
        }

        // Regulations Save
        function saveRegulations() {
            const text = document.getElementById('adminRegulationsEditor').value;
            const data = getStoredData();
            data.regulations = text;
            saveStoredData(data);
            alert("Regulamentul a fost actualizat cu succes!");
        }

        function openClientView() {
            document.getElementById('adminDashboard').classList.remove('active');
            document.getElementById('clientView').style.display = 'block';
            renderClientInterface();
            window.scrollTo({top: 0, behavior: 'smooth'});
        }
    </script>
</body>
</html>
