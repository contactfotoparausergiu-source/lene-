    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Criptare / Obfuscation parolă admin 1974
        const _adminHash = "MTk3NA=="; // Base64 pentru 1974

        // Default Data Store
        const defaultData = {
            regulations: "1. Rezervarea se face cu cel puțin 24 de ore înainte.\n2. Vă rugăm să fiți punctuali la ședința foto.\n3. Anularea sau reprogramarea se anunță telefonic cu minim 12 ore înainte.\n4. La ședințele foto de familie se recomandă un număr maxim de 4 persoane pentru a asigura confortul în decor.\n5. Plata se achită la sfârșitul ședinței foto.",
            sessionTypes: [
                { name: "Familie", desc: "Ședință foto magică dedicată întregii familii în decor de Crăciun." },
                { name: "Cuplu", desc: "Cadre romantice și festive pentru cupluri în atmosfera sărbătorilor." },
                { name: "Copii", desc: "Portrete minunate și cadre jucăușe pentru cei mici." }
            ],
            packages: [
                { sessionType: "Familie", name: "Pachetul Crăciun Clasic", price: "350 RON", desc: "45 minute, 15 fotografii editate digital, decor de poveste." },
                { sessionType: "Familie", name: "Pachetul Magic", price: "500 RON", desc: "60 minute, 30 fotografii editate, album inclus." },
                { sessionType: "Cuplu", name: "Pachetul Romantic", price: "300 RON", desc: "40 minute, 12 fotografii editate, decor cu luminițe și cadouri." },
                { sessionType: "Copii", name: "Pachetul Spiridușilor", price: "250 RON", desc: "30 minute, 10 fotografii editate, accesorii incluse." }
            ],
            extras: [
                { sessionType: "Familie", name: "Fotografie suplimentară editată", price: "25 RON/buc" },
                { sessionType: "Cuplu", name: "Sticlă de vin spumant decorativă", price: "50 RON" }
            ],
            appointments: []
        };

        // Load or Initialize localStorage
        function getStoredData() {
            if (!localStorage.getItem('foto_parau_data')) {
                localStorage.setItem('foto_parau_data', JSON.stringify(defaultData));
            }
            return JSON.parse(localStorage.getItem('foto_parau_data'));
        }

        function saveStoredData(data) {
            localStorage.setItem('foto_parau_data', JSON.stringify(data));
        }

        // Init on DOM Load
        document.addEventListener('DOMContentLoaded', () => {
            renderClientInterface();
        });

        // --- CLIENT VIEW & INTERACTIONS ---
        function renderClientInterface() {
            const data = getStoredData();
            
            // Render regulations in form
            document.getElementById('displayRegulationsText').innerText = data.regulations;
            
            // Populate Session Types dropdown
            const sessionSelect = document.getElementById('clientSessionType');
            sessionSelect.innerHTML = '<option value="">-- Selectează tipul --</option>';
            data.sessionTypes.forEach(s => {
                sessionSelect.innerHTML += `<option value="${s.name}">${s.name}</option>`;
            });

            // Render Public Packages
            const pkgGrid = document.getElementById('publicPackagesGrid');
            pkgGrid.innerHTML = '';
            if(data.packages.length === 0) {
                pkgGrid.innerHTML = '<p>Momentan nu sunt pachete afișate.</p>';
            } else {
                data.packages.forEach(p => {
                    pkgGrid.innerHTML += `
                        <div class="package-card">
                            <div>
                                <span class="badge badge-pending" style="margin-bottom: 0.5rem;">${p.sessionType}</span>
                                <h4 class="package-title">${p.name}</h4>
                                <div class="package-price">${p.price}</div>
                                <p class="package-desc">${p.desc}</p>
                            </div>
                            <button class="btn-gold" style="width: 100%; justify-content: center;" onclick="selectPackageAndScroll('${p.sessionType}', '${p.name}')">
                                <i class="fa-solid fa-calendar-plus"></i> Alege Acest Pachet
                            </button>
                        </div>
                    `;
                });
            }
        }

        function updatePackagesAndExtras() {
            const data = getStoredData();
            const selectedType = document.getElementById('clientSessionType').value;
            
            // Update packages dropdown
            const pkgSelect = document.getElementById('clientPackage');
            pkgSelect.innerHTML = '<option value="">-- Selectează pachetul --</option>';
            
            // Update extras dropdown
            const extraSelect = document.getElementById('clientExtraService');
            extraSelect.innerHTML = '<option value="Niciunul">Fără serviciu extra</option>';

            if (!selectedType) return;

            data.packages.filter(p => p.sessionType === selectedType).forEach(p => {
                pkgSelect.innerHTML += `<option value="${p.name} (${p.price})">${p.name} - ${p.price}</option>`;
            });

            data.extras.filter(e => e.sessionType === selectedType).forEach(e => {
                extraSelect.innerHTML += `<option value="${e.name} (${e.price})">${e.name} - ${e.price}</option>`;
            });

            // Dynamic help text update for family
            const helpText = document.getElementById('personsHelp');
            if (selectedType.toLowerCase().includes('familie')) {
                helpText.style.display = 'block';
            } else {
                helpText.style.display = 'none';
            }
        }

        function selectPackageAndScroll(sessionType, packageName) {
            document.getElementById('clientSessionType').value = sessionType;
            updatePackagesAndExtras();
            const pkgSelect = document.getElementById('clientPackage');
            for(let i=0; i<pkgSelect.options.length; i++) {
                if(pkgSelect.options[i].text.includes(packageName)) {
                    pkgSelect.selectedIndex = i;
                    break;
                }
            }
            document.getElementById('bookingSection').scrollIntoView({behavior: 'smooth'});
        }

        // Submit Booking and Send to WhatsApp
        function submitBooking(e) {
            e.preventDefault();

            const isChecked = document.getElementById('readRegulationsCheck').checked;
            if (!isChecked) {
                alert("Te rugăm să citești regulamentul și să bifezi că ești de acord înainte de a trimite solicitarea!");
                return;
            }

            const name = document.getElementById('clientName').value.trim();
            const phone = document.getElementById('clientPhone').value.trim();
            const sessionType = document.getElementById('clientSessionType').value;
            const packageVal = document.getElementById('clientPackage').value;
            const extraVal = document.getElementById('clientExtraService').value;
            const date = document.getElementById('clientDate').value;
            const time = document.getElementById('clientTime').value;
            const persons = document.getElementById('clientPersons').value;
            const outfits = document.getElementById('clientOutfits').value;
            const details = document.getElementById('clientDetails').value.trim() || "Fără detalii suplimentare";

            // Save booking in admin data
            const data = getStoredData();
            const newApp = {
                id: Date.now(),
                name,
                phone,
                sessionType,
                packageVal,
                extraVal,
                date,
                time,
                persons,
                outfits,
                details,
                status: "În așteptare"
            };
            data.appointments.push(newApp);
            saveStoredData(data);

            // Construct WhatsApp Message (Line by line exactly as requested)
            const waMessage = 
`Salut! Doresc o programare pentru o ședință foto de Crăciun la Foto Pârâu Studio:
- Nume: ${name}
- Telefon: ${phone}
- Tip ședință foto: ${sessionType}
- Pachet ales: ${packageVal}
- Serviciu extra: ${extraVal}
- Data dorită: ${date}
- Ora dorită: ${time}
- Persoane prezente: ${persons}
- Ținute per persoană: ${outfits}
- Detalii suplimentare: ${details}

Sunteți disponibil în ziua și ora respectivă?`;

            // WhatsApp link encoding
            const targetPhone = "40753814951";
            const encodedMessage = encodeURIComponent(waMessage);
            const whatsappUrl = `https://wa.me/${targetPhone}?text=${encodedMessage}`;

            // Open WhatsApp
            window.open(whatsappUrl, '_blank');

            // Reset Form & Notify
            document.getElementById('bookingForm').reset();
            alert("Solicitarea ta a fost înregistrată și se deschide WhatsApp-ul pentru trimiterea mesajului către studio!");
        }

        // --- ADMIN LOGIN & PANEL LOGIC ---
        function openAdminLoginModal() {
            document.getElementById('adminLoginModal').classList.add('active');
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            const pass = document.getElementById('adminPasswordInput').value;
            // Verificare criptare sigură în cod (Base64 hash)
            if (btoa(pass) === _adminHash) {
                closeModal('adminLoginModal');
                document.getElementById('adminPasswordInput').value = '';
                document.getElementById('clientView').style.display = 'none';
                document.getElementById('adminDashboard').classList.add('active');
                renderAdminPanel();
                window.scrollTo({top: 0, behavior: 'smooth'});
            } else {
                alert("Parolă incorectă!");
            }
        }

        function logoutAdmin() {
            document.getElementById('adminDashboard').classList.remove('active');
            document.getElementById('clientView').style.display = 'block';
            renderClientInterface();
        }

        function switchAdminTab(tabId, btn) {
            document.querySelectorAll('.admin-section-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.admin-tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            btn.classList.add('active');
            renderAdminPanel();
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }

        function renderAdminPanel() {
            const data = getStoredData();

            // 1. Appointments Table
            const appBody = document.getElementById('adminAppointmentsTableBody');
            appBody.innerHTML = '';
            if(data.appointments.length === 0) {
                appBody.innerHTML = '<tr><td colspan="6" style="text-align:center;">Nu există programări înregistrate.</td></tr>';
            } else {
                data.appointments.forEach(app => {
                    let badgeClass = 'badge-pending';
                    if(app.status === 'Prezent') badgeClass = 'badge-present';
                    if(app.status === 'Anulat') badgeClass = 'badge-cancelled';

                    appBody.innerHTML += `
                        <tr>
                            <td><strong>${app.name}</strong><br><small><a href="tel:${app.phone}">${app.phone}</a></small></td>
                            <td>${app.sessionType}<br><small>${app.packageVal}</small>${app.extraVal !== 'Niciunul' ? '<br><small style="color:var(--burgundy)">Extra: ' + app.extraVal + '</small>' : ''}</td>
                            <td>${app.date}<br><strong>${app.time}</strong></td>
                            <td>Persoane: ${app.persons}<br>Ținute: ${app.outfits}<br><small>${app.details}</small></td>
                            <td><span class="badge ${badgeClass}">${app.status}</span></td>
                            <td>
                                <div class="action-btns">
                                    <button class="btn-icon btn-status" title="Schimbă Status Prezent/Anulat" onclick="toggleAppStatus(${app.id})"><i class="fa-solid fa-check-double"></i></button>
                                    <button class="btn-icon btn-edit" title="Editează" onclick="editAppointment(${app.id})"><i class="fa-solid fa-pen"></i></button>
                                    <button class="btn-icon btn-delete" title="Șterge" onclick="deleteAppointment(${app.id})"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    `;
                });
            }

            // 2. Session Types Table
            const sessBody = document.getElementById('adminSessionsTableBody');
            sessBody.innerHTML = '';
            data.sessionTypes.forEach(s => {
                sessBody.innerHTML += `
                    <tr>
                        <td><strong>${s.name}</strong></td>
                        <td>${s.desc}</td>
                        <td>
                            <div class="action-btns">
                                <button class="btn-icon btn-edit" onclick="editSession('${s.name}')"><i class="fa-solid fa-pen"></i></button>
                                <button class="btn-icon btn-delete" onclick="deleteSession('${s.name}')"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            // 3. Packages Table
            const pkgBody = document.getElementById('adminPackagesTableBody');
            pkgBody.innerHTML = '';
            data.packages.forEach((p, idx) => {
                pkgBody.innerHTML += `
                    <tr>
                        <td><span class="badge badge-pending">${p.sessionType}</span></td>
                        <td><strong>${p.name}</strong></td>
                        <td style="color: var(--burgundy); font-weight: 700;">${p.price}</td>
                        <td>${p.desc}</td>
                        <td>
                            <div class="action-btns">
                                <button class="btn-icon btn-edit" onclick="editPackage(${idx})"><i class="fa-solid fa-pen"></i></button>
                                <button class="btn-icon btn-delete" onclick="deletePackage(${idx})"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            // 4. Extras Table
            const extraBody = document.getElementById('adminExtrasTableBody');
            extraBody.innerHTML = '';
            data.extras.forEach((e, idx) => {
                extraBody.innerHTML += `
                    <tr>
                        <td><span class="badge badge-pending">${e.sessionType}</span></td>
                        <td><strong>${e.name}</strong></td>
                        <td style="color: var(--burgundy); font-weight: 700;">${e.price}</td>
                        <td>
                            <div class="action-btns">
                                <button class="btn-icon btn-delete" onclick="deleteExtra(${idx})"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            // 5. Regulations Editor
            document.getElementById('adminRegulationsEditor').value = data.regulations;
        }

        // --- CRUD OPERATIONS FOR ADMIN ---

        // Session Types
        function openSessionModal() {
            document.getElementById('sessionModalTitle').innerText = "Adaugă Tip Ședință";
            document.getElementById('editSessionOriginalName').value = "";
            document.getElementById('modalSessionName').value = "";
            document.getElementById('modalSessionDesc').value = "";
            document.getElementById('sessionModal').classList.add('active');
        }

        function editSession(name) {
            const data = getStoredData();
            const s = data.sessionTypes.find(x => x.name === name);
            if(!s) return;
            document.getElementById('sessionModalTitle').innerText = "Editează Tip Ședință";
            document.getElementById('editSessionOriginalName').value = s.name;
            document.getElementById('modalSessionName').value = s.name;
            document.getElementById('modalSessionDesc').value = s.desc;
            document.getElementById('sessionModal').classList.add('active');
        }

        function saveSessionData(e) {
            e.preventDefault();
            const orig = document.getElementById('editSessionOriginalName').value;
            const name = document.getElementById('modalSessionName').value.trim();
            const desc = document.getElementById('modalSessionDesc').value.trim();
            const data = getStoredData();

            if(orig) {
                // Edit
                const idx = data.sessionTypes.findIndex(x => x.name === orig);
                if(idx !== -1) {
                    data.sessionTypes[idx].name = name;
                    data.sessionTypes[idx].desc = desc;
                }
            } else {
                // Add
                if(data.sessionTypes.some(x => x.name === name)) {
                    alert("Acest tip de ședință există deja!");
                    return;
                }
                data.sessionTypes.push({ name, desc });
            }
            saveStoredData(data);
            closeModal('sessionModal');
            renderAdminPanel();
        }

        function deleteSession(name) {
            if(confirm(`Sigur doriți să ștergeți tipul "${name}"?`)) {
                const data = getStoredData();
                data.sessionTypes = data.sessionTypes.filter(x => x.name !== name);
                saveStoredData(data);
                renderAdminPanel();
            }
        }

        // Packages
        function populateSessionDropdowns(selectId) {
            const data = getStoredData();
            const sel = document.getElementById(selectId);
            sel.innerHTML = '';
            data.sessionTypes.forEach(s => {
                sel.innerHTML += `<option value="${s.name}">${s.name}</option>`;
            });
        }

        function openPackageModal() {
            populateSessionDropdowns('modalPkgSessionType');
            document.getElementById('packageModalTitle').innerText = "Adaugă Pachet Foto";
            document.getElementById('editPackageIndex').value = "";
            document.getElementById('modalPkgName').value = "";
            document.getElementById('modalPkgPrice').value = "";
            document.getElementById('modalPkgDesc').value = "";
            document.getElementById('packageModal').classList.add('active');
        }

        function editPackage(idx) {
            populateSessionDropdowns('modalPkgSessionType');
            const data = getStoredData();
            const p = data.packages[idx];
            document.getElementById('packageModalTitle').innerText = "Editează Pachet Foto";
            document.getElementById('editPackageIndex').value = idx;
            document.getElementById('modalPkgSessionType').value = p.sessionType;
            document.getElementById('modalPkgName').value = p.name;
            document.getElementById('modalPkgPrice').value = p.price;
            document.getElementById('modalPkgDesc').value = p.desc;
            document.getElementById('packageModal').classList.add('active');
        }

        function savePackageData(e) {
            e.preventDefault();
            const idx = document.getElementById('editPackageIndex').value;
            const sessionType = document.getElementById('modalPkgSessionType').value;
            const name = document.getElementById('modalPkgName').value.trim();
            const price = document.getElementById('modalPkgPrice').value.trim();
            const desc = document.getElementById('modalPkgDesc').value.trim();
            const data = getStoredData();

            if(idx !== "") {
                data.packages[idx] = { sessionType, name, price, desc };
            } else {
                data.packages.push({ sessionType, name, price, desc });
            }
            saveStoredData(data);
            closeModal('packageModal');
            renderAdminPanel();
        }

        function deletePackage(idx) {
            if(confirm("Sigur doriți să ștergeți acest pachet?")) {
                const data = getStoredData();
                data.packages.splice(idx, 1);
                saveStoredData(data);
                renderAdminPanel();
            }
        }

