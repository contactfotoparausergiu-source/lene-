        function saveExtraData(e) {
            e.preventDefault();
            const sessionType = document.getElementById('modalExtraSessionType').value;
            const name = document.getElementById('modalExtraName').value.trim();
            const price = document.getElementById('modalExtraPrice').value.trim();
            const data = getStoredData();

            data.extras.push({ sessionType, name, price });
            saveStoredData(data);
            closeModal('extraModal');
            renderAdminPanel();
