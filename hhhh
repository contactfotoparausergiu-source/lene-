<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foto Pârâu Studio - Ședințe Foto de Crăciun</title>
    <!-- Google Fonts & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --emerald-dark: #072e20;
            --emerald: #0b4f38;
            --emerald-light: #126b4c;
            --burgundy-dark: #5c0617;
            --burgundy: #8b0020;
            --burgundy-light: #ad1134;
            --gold: #d4af37;
            --gold-light: #f3e5ab;
            --cream: #fbf9f4;
            --charcoal: #222222;
            --white: #ffffff;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--cream);
            color: var(--charcoal);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, .serif-font {
            font-family: 'Playfair Display', serif;
        }

        /* Top Bar & Header */
        header {
            background: linear-gradient(135deg, var(--emerald-dark), var(--emerald));
            color: var(--white);
            padding: 1.5rem 2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 3px solid var(--gold);
        }

        .header-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .logo-icon {
            font-size: 2.2rem;
            color: var(--gold);
        }

        .logo-text h1 {
            font-size: 1.8rem;
            color: var(--white);
            letter-spacing: 0.5px;
        }

        .logo-text p {
            font-size: 0.85rem;
            color: var(--gold-light);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .header-actions {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .btn-gold {
            background: linear-gradient(135deg, var(--gold), #b89728);
            color: var(--emerald-dark);
            border: none;
            padding: 0.75rem 1.5rem;
            font-weight: 700;
            border-radius: 50px;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
            text-decoration: none;
            font-size: 0.95rem;
        }

        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.5);
            background: linear-gradient(135deg, #e6c552, var(--gold));
        }

        .btn-outline {
            background: transparent;
            color: var(--white);
            border: 2px solid var(--gold);
            padding: 0.65rem 1.4rem;
            font-weight: 600;
            border-radius: 50px;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-outline:hover {
            background: var(--gold);
            color: var(--emerald-dark);
        }

        /* Main Container */
        .main-container {
            max-width: 1200px;
            margin: 3rem auto;
            padding: 0 1.5rem;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(7, 46, 32, 0.85), rgba(92, 6, 23, 0.85)), url('https://images.unsplash.com/photo-1543589077-47d81606c1bf?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
            border-radius: 20px;
            padding: 5rem 2rem;
            text-align: center;
            color: var(--white);
            margin-bottom: 3rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            border: 2px solid var(--gold);
        }

        .hero h2 {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: var(--gold-light);
        }

        .hero p {
            font-size: 1.2rem;
            max-width: 700px;
            margin: 0 auto 2rem auto;
            opacity: 0.95;
        }

        /* Form & Content Sections */
        .section-card {
            background: var(--white);
            border-radius: 16px;
            padding: 2.5rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            margin-bottom: 3rem;
            border: 1px solid rgba(212, 175, 55, 0.2);
        }

        .section-title {
            font-size: 2rem;
            color: var(--emerald-dark);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            border-bottom: 2px solid var(--gold-light);
            padding-bottom: 0.75rem;
        }

        .section-title i {
            color: var(--burgundy);
        }

        /* Booking Form Styling */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .form-group {
            margin-bottom: 1.2rem;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--emerald-dark);
        }

        input, select, textarea {
            width: 100%;
            padding: 0.85rem 1rem;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-family: inherit;
            font-size: 1rem;
            transition: var(--transition);
            background: var(--cream);
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--emerald);
            background: var(--white);
            box-shadow: 0 0 0 4px rgba(11, 79, 56, 0.1);
        }

        .help-text {
            font-size: 0.8rem;
            color: var(--burgundy);
            margin-top: 0.3rem;
            font-weight: 500;
        }

        /* Regulations Box in Form */
        .regulations-box {
            background: #fff8f8;
            border: 2px dashed var(--burgundy);
            padding: 1.5rem;
            border-radius: 10px;
            margin: 1.5rem 0;
        }

        .regulations-box h4 {
            color: var(--burgundy);
            margin-bottom: 0.5rem;
        }

        .regulations-content {
            max-height: 150px;
            overflow-y: auto;
            font-size: 0.9rem;
            color: #555;
            margin-bottom: 1rem;
            padding-right: 0.5rem;
            white-space: pre-line;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            font-weight: 600;
            color: var(--emerald-dark);
        }

        .checkbox-label input {
            width: 20px;
            height: 20px;
            accent-color: var(--emerald);
            cursor: pointer;
        }

        /* Public Packages & Services Display */
        .packages-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-top: 1.5rem;
        }

        .package-card {
            background: linear-gradient(145deg, #ffffff, #f9f6ee);
            border-radius: 12px;
            padding: 2rem;
            border: 1px solid var(--gold);
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .package-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 6px;
            background: linear-gradient(90deg, var(--emerald), var(--burgundy));
        }

        .package-title {
            font-size: 1.5rem;
            color: var(--emerald-dark);
            margin-bottom: 0.5rem;
        }

        .package-price {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--burgundy);
            margin-bottom: 1rem;
        }

        .package-desc {
            font-size: 0.95rem;
            color: #666;
            margin-bottom: 1.5rem;
        }

        /* Modal Overlay */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(5px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition);
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-card {
            background: var(--white);
            width: 90%;
            max-width: 500px;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            position: relative;
            border: 2px solid var(--gold);
            transform: translateY(20px);
            transition: var(--transition);
        }

        .modal-overlay.active .modal-card {
            transform: translateY(0);
        }

        .modal-close {
            position: absolute;
            top: 1.2rem;
            right: 1.2rem;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--charcoal);
            cursor: pointer;
            transition: var(--transition);
        }

        .modal-close:hover {
            color: var(--burgundy);
        }

        .modal-card h3 {
            color: var(--emerald-dark);
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
        }

        /* Admin Panel Styles */
        .admin-dashboard {
            display: none;
        }

        .admin-dashboard.active {
            display: block;
        }

        .admin-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            border-bottom: 2px solid #e0e0e0;
            padding-bottom: 1rem;
        }

        .admin-tab-btn {
            background: var(--cream);
            border: 1px solid #d0d0d0;
            padding: 0.75rem 1.25rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            color: var(--emerald-dark);
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .admin-tab-btn.active, .admin-tab-btn:hover {
            background: var(--emerald);
            color: var(--white);
            border-color: var(--emerald);
        }

        .admin-section-pane {
            display: none;
        }

        .admin-section-pane.active {
            display: block;
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
            margin-top: 1rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.95rem;
        }

        th, td {
            padding: 1rem;
            border-bottom: 1px solid #eee;
        }

        th {
            background: var(--emerald-dark);
            color: var(--white);
            font-weight: 600;
        }

        tr:hover {
            background-color: rgba(212, 175, 55, 0.05);
        }

        .badge {
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
        }

        .badge-pending { background: #fff3cd; color: #856404; }
        .badge-present { background: #d4edda; color: #155724; }
        .badge-cancelled { background: #f8d7da; color: #721c24; }

        .action-btns {
            display: flex;
            gap: 0.5rem;
        }

        .btn-icon {
            background: none;
            border: none;
            cursor: pointer;
            padding: 0.4rem;
            border-radius: 6px;
            transition: var(--transition);
            font-size: 1rem;
        }

        .btn-edit { color: var(--emerald); background: rgba(11, 79, 56, 0.1); }
        .btn-edit:hover { background: var(--emerald); color: var(--white); }

        .btn-delete { color: var(--burgundy); background: rgba(139, 0, 32, 0.1); }
        .btn-delete:hover { background: var(--burgundy); color: var(--white); }

        .btn-status { color: #d4af37; background: rgba(212, 175, 55, 0.1); }
        .btn-status:hover { background: #d4af37; color: var(--white); }

        /* Footer */
        footer {
            background: var(--emerald-dark);
            color: var(--white);
            text-align: center;
            padding: 2.5rem;
            margin-top: 4rem;
            border-top: 3px solid var(--gold);
        }

        footer p {
            color: var(--gold-light);
            font-size: 0.95rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .hero h2 { font-size: 2.2rem; }
            .header-container { flex-direction: column; align-items: stretch; text-align: center; }
            .logo-area { justify-content: center; }
            .header-actions { justify-content: center; }
        }
    </style>
</head>
<body>

    <!-- Header & Navigation -->
    <header>
        <div class="header-container">
            <div class="logo-area">
                <div class="logo-icon"><i class="fa-solid fa-holly-berry"></i></div>
                <div class="logo-text">
                    <h1>Foto Pârâu Studio</h1>
                    <p>Magia Sărbătorilor de Crăciun</p>
                </div>
            </div>
            <div class="header-actions">
                <button class="btn-outline" onclick="openClientView()"><i class="fa-solid fa-calendar-check"></i> Programare</button>
                <button class="btn-gold" onclick="openAdminLoginModal()"><i class="fa-solid fa-lock"></i> Panou Admin</button>
            </div>
        </div>
    </header>

    <div class="main-container">

        <!-- PUBLIC WEBSITE VIEW (Client Booking & Packages) -->
        <div id="clientView">
            
            <!-- Hero Section -->
            <section class="hero">
                <h2>Creează Amintiri de Neprețuit</h2>
                <p>Rezervă acum ședința foto de Crăciun la Foto Pârâu Studio și surprinde magia sărbătorilor alături de cei dragi într-un decor de poveste!</p>
                <button class="btn-gold" onclick="document.getElementById('bookingSection').scrollIntoView({behavior: 'smooth'})">
                    <i class="fa-solid fa-gift"></i> Rezervă Acum Ședința
                </button>
            </section>

            <!-- Packages Presentation -->
            <section class="section-card">
                <h3 class="section-title"><i class="fa-solid fa-star"></i> Pachetele Noastre Festive</h3>
                <div id="publicPackagesGrid" class="packages-grid">
                    <!-- Dinamic din JS -->
                </div>
            </section>

            <!-- Booking Form Section -->
            <section id="bookingSection" class="section-card">
                <h3 class="section-title"><i class="fa-solid fa-pen-nib"></i> Formular Programare Ședință Foto</h3>
                
                <form id="bookingForm" onsubmit="submitBooking(event)">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="clientName">Numele Complet *</label>
                            <input type="text" id="clientName" required placeholder="Ex: Popescu Maria">
                        </div>

                        <div class="form-group">
                            <label for="clientPhone">Telefon *</label>
                            <input type="tel" id="clientPhone" required placeholder="Ex: 0712345678">
                        </div>

                        <div class="form-group">
                            <label for="clientSessionType">Tipul de Ședință Foto *</label>
                            <select id="clientSessionType" required onchange="updatePackagesAndExtras()">
                                <option value="">-- Selectează tipul --</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="clientPackage">Pachetul Ales *</label>
                            <select id="clientPackage" required>
                                <option value="">-- Mai întâi alege tipul de ședință --</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="clientExtraService">Serviciu Extra (Opțional)</label>
                            <select id="clientExtraService">
                                <option value="Niciunul">Fără serviciu extra</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="clientDate">Data Dorită *</label>
                            <input type="date" id="clientDate" required>
                        </div>

                        <div class="form-group">
                            <label for="clientTime">Ora Dorită *</label>
                            <input type="time" id="clientTime" required>
                        </div>

                        <div class="form-group">
                            <label for="clientPersons">Câte persoane vor fi prezente? *</label>
                            <input type="number" id="clientPersons" min="1" max="20" required placeholder="Nr. persoane">
                            <div class="help-text" id="personsHelp">La pachetul de familii se recomandă maxim 4 persoane.</div>
                        </div>

                        <div class="form-group">
                            <label for="clientOutfits">Câte ținute va avea fiecare persoană? *</label>
                            <input type="number" id="clientOutfits" min="1" max="5" required placeholder="Nr. ținute">
                        </div>

                        <div class="form-group full-width">
                            <label for="clientDetails">Detalii Suplimentare</label>
                            <textarea id="clientDetails" rows="3" placeholder="Mențiuni speciale, vârsta copiilor, preferințe de decor..."></textarea>
                        </div>

                        <!-- Regulations Box -->
                        <div class="form-group full-width">
                            <div class="regulations-box">
                                <h4>Regulamentul Studio Foto Pârâu</h4>
                                <div id="displayRegulationsText" class="regulations-content">
                                    Se încarcă regulamentul...
                                </div>
                                <label class="checkbox-label">
                                    <input type="checkbox" id="readRegulationsCheck" required>
                                    Am citit și sunt de acord cu regulamentul studioului foto
                                </label>
                            </div>
                        </div>
                    </div>

                    <div style="text-align: center; margin-top: 1.5rem;">
                        <button type="submit" class="btn-gold" style="font-size: 1.1rem; padding: 1rem 2.5rem;">
                            <i class="fa-brands fa-whatsapp"></i> Trimite Solicitarea pe WhatsApp
                        </button>
                    </div>
                </form>
            </section>
        </div>

        <!-- ADMIN PANEL VIEW -->
        <div id="adminDashboard" class="admin-dashboard">
            <div class="section-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
                    <h2 class="section-title" style="margin-bottom:0;"><i class="fa-solid fa-gauge-high"></i> Panou Administrator - Foto Pârâu Studio</h2>
                    <button class="btn-outline" style="border-color: var(--burgundy); color: var(--burgundy);" onclick="logoutAdmin()">
                        <i class="fa-solid fa-right-from-bracket"></i> Deconectare
                    </button>
                </div>

                <!-- Admin Tabs -->
                <div class="admin-tabs">
                    <button class="admin-tab-btn active" onclick="switchAdminTab('appointmentsTab', this)"><i class="fa-solid fa-calendar-days"></i> Programări</button>
                    <button class="admin-tab-btn" onclick="switchAdminTab('sessionsTab', this)"><i class="fa-solid fa-camera"></i> Tipuri Ședințe</button>
                    <button class="admin-tab-btn" onclick="switchAdminTab('packagesTab', this)"><i class="fa-solid fa-box-archive"></i> Pachete Foto</button>
                    <button class="admin-tab-btn" onclick="switchAdminTab('extrasTab', this)"><i class="fa-solid fa-plus-minus"></i> Servicii Extra</button>
                    <button class="admin-tab-btn" onclick="switchAdminTab('regulationsTab', this)"><i class="fa-solid fa-file-contract"></i> Regulament</button>
                </div>

                <!-- TAB 1: APPOINTMENTS -->
                <div id="appointmentsTab" class="admin-section-pane active">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                        <h3 style="color: var(--emerald-dark);">Gestionare Programări</h3>
                        <button class="btn-gold" onclick="openAppointmentModal()"><i class="fa-solid fa-plus"></i> Adaugă Programare Manual</button>
                    </div>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Nume & Telefon</th>
                                    <th>Ședință / Pachet</th>
                                    <th>Data & Ora</th>
                                    <th>Detalii & Persoane</th>
                                    <th>Status</th>
                                    <th>Acțiuni</th>
                                </tr>
                            </thead>
                            <tbody id="adminAppointmentsTableBody">
                                <!-- Dinamic din JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB 2: SESSION TYPES -->
                <div id="sessionsTab" class="admin-section-pane">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                        <h3 style="color: var(--emerald-dark);">Tipuri de Ședințe Foto</h3>
                        <button class="btn-gold" onclick="openSessionModal()"><i class="fa-solid fa-plus"></i> Adaugă Tip Ședință</button>
                    </div>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Denumire</th>
                                    <th>Descriere</th>
                                    <th>Acțiuni</th>
                                </tr>
                            </thead>
                            <tbody id="adminSessionsTableBody">
                                <!-- Dinamic din JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB 3: PACKAGES -->
                <div id="packagesTab" class="admin-section-pane">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                        <h3 style="color: var(--emerald-dark);">Pachete Foto</h3>
                        <button class="btn-gold" onclick="openPackageModal()"><i class="fa-solid fa-plus"></i> Adaugă Pachet</button>
                    </div>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Tip Ședință</th>
                                    <th>Nume Pachet</th>
                                    <th>Preț</th>
                                    <th>Descriere</th>
                                    <th>Acțiuni</th>
                                </tr>
                            </thead>
                            <tbody id="adminPackagesTableBody">
                                <!-- Dinamic din JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB 4: EXTRA SERVICES -->
                <div id="extrasTab" class="admin-section-pane">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                        <h3 style="color: var(--emerald-dark);">Servicii Extra per Tip Ședință</h3>
                        <button class="btn-gold" onclick="openExtraModal()"><i class="fa-solid fa-plus"></i> Adaugă Serviciu Extra</button>
                    </div>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Tip Ședință</th>
                                    <th>Nume Serviciu Extra</th>
                                    <th>Preț</th>
                                    <th>Acțiuni</th>
                                </tr>
                            </thead>
                            <tbody id="adminExtrasTableBody">
                                <!-- Dinamic din JS -->
